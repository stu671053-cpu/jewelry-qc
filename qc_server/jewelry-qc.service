[Unit]
Description=域骉珠宝质检监控系统
After=network.target
Wants=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/jewelry_qc/qc_server
ExecStart=/usr/bin/python3 /home/pi/jewelry_qc/qc_server/app.py
Restart=always
RestartSec=10
StandardOutput=append:/home/pi/jewelry_qc/logs/output.log
StandardError=append:/home/pi/jewelry_qc/logs/error.log

# 安全加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/home/pi/jewelry_qc/data

[Install]
WantedBy=multi-user.target
